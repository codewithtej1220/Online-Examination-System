<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f4f7fb;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
        }
        .header {
            background: linear-gradient(135deg, #146c94 0%, #0d4f6f 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #146c94;
            font-size: 22px;
            margin-top: 0;
        }
        .info-box {
            background: #f4f7fb;
            border-left: 4px solid #146c94;
            padding: 15px;
            margin: 20px 0;
        }
        .info-box strong {
            color: #146c94;
        }
        .button {
            display: inline-block;
            background: #146c94;
            color: white;
            padding: 14px 28px;
            text-decoration: none;
            border-radius: 6px;
            margin: 20px 0;
            font-weight: 600;
        }
        .button:hover {
            background: #0d4f6f;
        }
        .footer {
            background: #f4f7fb;
            padding: 30px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        .footer a {
            color: #146c94;
            text-decoration: none;
        }
        @media only screen and (max-width: 600px) {
            .content {
                padding: 20px 15px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎓 <%= appName %></h1>
        </div>
        
        <div class="content">
            <h2>Welcome, <%= user.username %>! 👋</h2>
            
            <p>Your account has been successfully created. Welcome to the Online Examination System!</p>
            
            <div class="info-box">
                <strong>👤 Username:</strong> <%= user.username %><br>
                <strong>🎯 Role:</strong> <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %><br>
                <strong>📅 Registration Date:</strong> <%= new Date().toLocaleDateString() %>
            </div>
            
            <% if (user.role === 'student') { %>
            <h3>As a Student, you can:</h3>
            <ul>
                <li>✅ View assigned exams</li>
                <li>✅ Take exams within scheduled time</li>
                <li>✅ View your results</li>
                <li>✅ Track your performance</li>
            </ul>
            <% } else if (user.role === 'faculty') { %>
            <h3>As Faculty, you can:</h3>
            <ul>
                <li>✅ Create and manage questions</li>
                <li>✅ Schedule exams</li>
                <li>✅ Assign exams to students</li>
                <li>✅ Evaluate and publish results</li>
            </ul>
            <% } else if (user.role === 'admin') { %>
            <h3>As Admin, you have:</h3>
            <ul>
                <li>✅ Full system access</li>
                <li>✅ User management</li>
                <li>✅ System monitoring</li>
                <li>✅ Configuration control</li>
            </ul>
            <% } %>
            
            <center>
                <a href="<%= appUrl %>" class="button">Go to <%= appName %> →</a>
            </center>
            
            <p style="margin-top: 30px; color: #666; font-size: 14px;">
                <strong>📌 Tip:</strong> Bookmark the site for easy access!
            </p>
        </div>
        
        <div class="footer">
            <p>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</p>
            <p>
                <a href="<%= appUrl %>">Dashboard</a> •
                <a href="<%= appUrl %>/help">Help</a> •
                <a href="<%= appUrl %>/contact">Contact</a>
            </p>
        </div>
    </div>
</body>
</html>
