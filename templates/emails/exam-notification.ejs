<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f4f7fb;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
        }
        .header {
            background: linear-gradient(135deg, #146c94 0%, #0d4f6f 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #146c94;
            font-size: 22px;
            margin-top: 0;
        }
        .exam-card {
            background: #f4f7fb;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            border: 2px solid #146c94;
        }
        .exam-title {
            font-size: 20px;
            font-weight: 600;
            color: #146c94;
            margin-bottom: 15px;
        }
        .exam-details {
            display: grid;
            gap: 10px;
        }
        .detail-row {
            display: flex;
            align-items: start;
        }
        .detail-label {
            font-weight: 600;
            min-width: 100px;
            color: #666;
        }
        .button {
            display: inline-block;
            background: #146c94;
            color: white;
            padding: 14px 28px;
            text-decoration: none;
            border-radius: 6px;
            margin: 20px 0;
            font-weight: 600;
        }
        .alert {
            background: #fef0c7;
            border-left: 4px solid #ad6800;
            padding: 15px;
            margin: 20px 0;
            color: #664d00;
        }
        .footer {
            background: #f4f7fb;
            padding: 30px;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📝 New Exam Scheduled</h1>
        </div>
        
        <div class="content">
            <h2>Hello <%= user.username %>,</h2>
            
            <p>A new exam has been scheduled for you. Please review the details below:</p>
            
            <div class="exam-card">
                <div class="exam-title">📚 <%= exam.title %></div>
                <div class="exam-details">
                    <div class="detail-row">
                        <span class="detail-label">📅 Scheduled:</span>
                        <span><%= new Date(exam.scheduled_time).toLocaleString() %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">⏱️ Duration:</span>
                        <span><%= exam.duration_minutes %> minutes</span>
                    </div>
                    <% if (exam.randomize_questions) { %>
                    <div class="detail-row">
                        <span class="detail-label">🔀 Format:</span>
                        <span>Questions will be randomized</span>
                    </div>
                    <% } %>
                </div>
            </div>
            
            <div class="alert">
                <strong>⚠️ Important Reminders:</strong>
                <ul style="margin: 10px 0; padding-left: 20px;">
                    <li>Make sure you have a stable internet connection</li>
                    <li>Login at least 5 minutes before the exam starts</li>
                    <li>Exam will auto-submit when time expires</li>
                    <li>Ensure your browser is up to date</li>
                </ul>
            </div>
            
            <center>
                <a href="<%= appUrl %>" class="button">Go to Dashboard →</a>
            </center>
            
            <p style="margin-top: 30px; color: #666; font-size: 14px;">
                Good luck with your exam! 🍀
            </p>
        </div>
        
        <div class="footer">
            <p>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
